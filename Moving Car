<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=<device-width>, initial-scale=1.0">
    <title>Moving Car</title>
</head>
<style>
    
    #road{
        
        height:150px;
        width:100%;
        position:absolute;
        background-color: black;
        border:1px solid black;
        bottom:0px;
        left:0px;
        display:flex;
        justify-content: space-evenly;
        align-items: center;
        
    }
    .zebra{
        height:20px;
        width:150px;
        border:1px solid black;
        background-color: white;
 
    }
    #car{
        height: 220px;
        position:absolute;
        bottom: 108px;
        z-index: -1;
        animation:moveCar 4s linear infinite ;
         
    }
    

    @keyframes moveCar {
        from{
            left:100%;
        }
        to{
            left:0%;
        }
        
    }
   
    
</style>
<body>
    
    <div id="road">
        <div class="zebra"></div>
        <div class="zebra"></div>
        <div class="zebra"></div>
    </div>
    <img id ="car" src="https://drawcarz.com/wp-content/uploads/2019/03/how-to-draw-a-car-easy-featured-image.jpg" alt="image of car">
    
    
</body>
</html>
